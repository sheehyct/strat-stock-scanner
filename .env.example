# Tradier API Configuration (required)
# Obtain a production token at https://documentation.tradier.com/
TRADIER_API_TOKEN=your_tradier_production_token_here

# Optional sandbox toggle (production by default; the client derives the base URL
# from this flag, so there is intentionally no separate URL override knob)
TRADIER_USE_SANDBOX=false
TRADIER_SANDBOX_TOKEN=

# OAuth 2.1 Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate_this_with_secrets_module
OAUTH_CLIENT_ID=claude-mcp-client
OAUTH_CLIENT_SECRET=generate_this_with_secrets_module
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Two-phase rollout for OAuth client validation. Default False = log
# mismatches at WARN level but still serve the request. Watch Railway
# logs for `oauth_client_id_mismatch` / `oauth_redirect_uri_not_in_allowlist`
# lines; once the observed values match settings, flip to True to enforce.
STRICT_OAUTH_VALIDATION=false
# Comma-separated allow-list of acceptable redirect_uri values. Leave
# unset to skip the redirect_uri check entirely. Example:
# OAUTH_REDIRECT_URI_ALLOWLIST=https://claude.ai/api/mcp/auth_callback
OAUTH_REDIRECT_URI_ALLOWLIST=

# Rate Limiting (Tradier prod cap is 60-120 req/min; default 100 for safety)
RATE_LIMIT_PER_MINUTE=100
MAX_CONCURRENT_REQUESTS=4

# Server Configuration
PORT=8080
DEBUG=false
LOG_LEVEL=INFO
SERVER_URL=https://your-app.up.railway.app  # REQUIRED: Set to your Railway deployment URL
